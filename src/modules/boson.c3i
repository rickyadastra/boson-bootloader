module boson;

const usz MAX_MEMORY_REGIONS = 0x1000 / MemoryRegion::size;		// 128 entries

enum MemoryRegionType : uint {
	BOOTLOADER,
	AVAILABLE,
	FIRMWARE,
	ACPI,
	MMIO,
	RESERVED,
	KERNEL,
}

struct MemoryRegion {
	MemoryRegionType type;
	uptr base;
	uptr baseVirt;
	usz size;
}

struct BootloaderKernelStack {
	uint size;
	uptr base;
	uptr end;
}

struct BootloaderPayload {
	uptr pageTablePtr;
	BootloaderKernelStack stack;
	MemoryRegion* memoryRegionMap;
	uint memoryRegionEntries;
	ulong totalMemoryBytes;

	// vendor tables
	uptr rsdpAddr;
}
