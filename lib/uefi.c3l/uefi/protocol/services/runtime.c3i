module uefi::protocol::runtime_services;

alias ResetSystemFn = fn void (ResetType, EfiStatus, usz, void*);

enum ResetType : uint {
    COLD,
    WARM,
    SHUTDOWN,
    PLATFORM_SPECIFIC,
}

module uefi;
import uefi::protocol::runtime_services;
import uefi::protocol::time;

struct RuntimeServices @packed {
    inline TableHeader header;

    GetTimeFn get_time;
    void* set_time;
    void* get_wakeup_time;
    void* set_wakeup_time;

    void* set_virtual_address_map;
    void* convert_pointer;

    void* get_variable;
    void* get_next_variable_name;
    void* set_variable;

    void* get_next_high_monotonic_count;
    ResetSystemFn reset_system;
    void* update_capsule;
    void* query_capsule_capabilities;
    void* query_variable_info;
}
